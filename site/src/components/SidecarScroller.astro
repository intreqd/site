---
export interface SidecarItem {
  title: string;
  subtitle: string;
  description: string;
  badges: string[];
  url: string;
  logoLeft: string;
  logoRight: string;
}

export interface Props {
  items: SidecarItem[];
}

const { items } = Astro.props;
---

<div id="sidecar-scroller-container" class="space-y-3 group mt-auto">
  <!-- Top bar with section title and active item dots -->
  <div class="flex items-center justify-between gap-3 px-1">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
      </span>
      <span class="text-xs uppercase font-bold tracking-wider text-base-content/70">
        Featured Sidecars
      </span>
    </div>

    <div class="flex items-center gap-1.5" id="sidecar-dots">
      {items.map((util, idx) => (
        <button
          type="button"
          data-index={idx}
          aria-label={`Show ${util.title}`}
          class:list={[
            "sidecar-dot h-2 rounded-full transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary",
            idx < 2 ? "w-4 bg-primary" : "w-2 bg-base-300 hover:bg-base-content/30"
          ]}
        />
      ))}
    </div>
  </div>

  <!-- Always display 2 card slots (never blank) -->
  <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
    <!-- Slot 0 -->
    <div
      id="sidecar-slot-0"
      class="flex flex-col justify-between gap-3 rounded-box border border-base-300 bg-base-100 p-5 shadow-sm transition-all duration-300 hover:shadow-md hover:border-primary/40 group/card opacity-100 scale-100"
    >
      <div class="space-y-2">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <img id="slot-0-logo-left" src={items[0].logoLeft} alt="" class="h-6 w-6 object-contain dark:invert" />
            <span class="text-xs text-base-content/40 font-mono">&rarr;</span>
            <img id="slot-0-logo-right" src={items[0].logoRight} alt="" class="h-6 w-6 object-contain dark:invert" />
            <h3 id="slot-0-title" class="font-bold text-base text-base-content group-hover/card:text-primary transition-colors">
              {items[0].title}
            </h3>
          </div>
          <span class="badge badge-xs font-mono uppercase tracking-wider bg-base-200 border-base-300 text-base-content/70 px-2 py-1.5">
            Sidecar
          </span>
        </div>
        <p id="slot-0-subtitle" class="text-xs font-semibold text-primary">{items[0].subtitle}</p>
        <p id="slot-0-description" class="text-xs text-base-content/70 leading-relaxed">
          {items[0].description}
        </p>
      </div>

      <div class="flex items-center justify-between gap-2 pt-2 border-t border-base-200 mt-1">
        <div id="slot-0-badges" class="flex flex-wrap gap-1">
          {items[0].badges.map((badge) => (
            <span class="badge badge-xs font-medium bg-base-200 text-base-content/80 border-0 px-2 py-1">
              {badge}
            </span>
          ))}
        </div>
        <a
          id="slot-0-url"
          href={items[0].url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-primary"
        >
          Download &rarr;
        </a>
      </div>
    </div>

    <!-- Slot 1 -->
    <div
      id="sidecar-slot-1"
      class="hidden sm:flex flex-col justify-between gap-3 rounded-box border border-base-300 bg-base-100 p-5 shadow-sm transition-all duration-300 hover:shadow-md hover:border-primary/40 group/card opacity-100 scale-100"
    >
      <div class="space-y-2">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <img id="slot-1-logo-left" src={items[1 % items.length].logoLeft} alt="" class="h-6 w-6 object-contain dark:invert" />
            <span class="text-xs text-base-content/40 font-mono">&rarr;</span>
            <img id="slot-1-logo-right" src={items[1 % items.length].logoRight} alt="" class="h-6 w-6 object-contain dark:invert" />
            <h3 id="slot-1-title" class="font-bold text-base text-base-content group-hover/card:text-primary transition-colors">
              {items[1 % items.length].title}
            </h3>
          </div>
          <span class="badge badge-xs font-mono uppercase tracking-wider bg-base-200 border-base-300 text-base-content/70 px-2 py-1.5">
            Sidecar
          </span>
        </div>
        <p id="slot-1-subtitle" class="text-xs font-semibold text-primary">{items[1 % items.length].subtitle}</p>
        <p id="slot-1-description" class="text-xs text-base-content/70 leading-relaxed">
          {items[1 % items.length].description}
        </p>
      </div>

      <div class="flex items-center justify-between gap-2 pt-2 border-t border-base-200 mt-1">
        <div id="slot-1-badges" class="flex flex-wrap gap-1">
          {items[1 % items.length].badges.map((badge) => (
            <span class="badge badge-xs font-medium bg-base-200 text-base-content/80 border-0 px-2 py-1">
              {badge}
            </span>
          ))}
        </div>
        <a
          id="slot-1-url"
          href={items[1 % items.length].url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-primary"
        >
          Download &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ items }}>
  function initSidecarShuffle() {
    const container = document.getElementById('sidecar-scroller-container');
    if (!container || !items || items.length === 0) return;

    const slot0 = document.getElementById('sidecar-slot-0');
    const slot1 = document.getElementById('sidecar-slot-1');
    const dots = container.querySelectorAll('.sidecar-dot');

    let activeIndexSlot0 = 0;
    let activeIndexSlot1 = items.length > 1 ? 1 : 0;
    let timer = null;
    let turn = 0;

    function renderCardInSlot(slotNum, itemIndex) {
      const slotEl = slotNum === 0 ? slot0 : slot1;
      const logoLeft = document.getElementById(`slot-${slotNum}-logo-left`);
      const logoRight = document.getElementById(`slot-${slotNum}-logo-right`);
      const title = document.getElementById(`slot-${slotNum}-title`);
      const subtitle = document.getElementById(`slot-${slotNum}-subtitle`);
      const description = document.getElementById(`slot-${slotNum}-description`);
      const badgesContainer = document.getElementById(`slot-${slotNum}-badges`);
      const urlBtn = document.getElementById(`slot-${slotNum}-url`);

      if (!slotEl || !items[itemIndex]) return;

      const item = items[itemIndex];
      if (logoLeft) logoLeft.src = item.logoLeft;
      if (logoRight) logoRight.src = item.logoRight;
      if (title) title.textContent = item.title;
      if (subtitle) subtitle.textContent = item.subtitle;
      if (description) description.textContent = item.description;
      if (urlBtn) urlBtn.href = item.url;

      if (badgesContainer) {
        badgesContainer.innerHTML = item.badges
          .map(b => `<span class="badge badge-xs font-medium bg-base-200 text-base-content/80 border-0 px-2 py-1">${b}</span>`)
          .join('');
      }
    }

    function updateDots() {
      dots.forEach((dot, idx) => {
        const isVisible = (idx === activeIndexSlot0 || idx === activeIndexSlot1);
        if (isVisible) {
          dot.classList.remove('w-2', 'bg-base-300', 'hover:bg-base-content/30');
          dot.classList.add('w-4', 'bg-primary');
        } else {
          dot.classList.remove('w-4', 'bg-primary');
          dot.classList.add('w-2', 'bg-base-300', 'hover:bg-base-content/30');
        }
      });
    }

    function shuffleNext() {
      if (items.length <= 2) return;

      const slotToUpdate = turn % 2;
      turn++;

      const unusedIndices = [];
      for (let i = 0; i < items.length; i++) {
        if (i !== activeIndexSlot0 && i !== activeIndexSlot1) {
          unusedIndices.push(i);
        }
      }

      if (unusedIndices.length === 0) return;
      const newIndex = unusedIndices[Math.floor(Math.random() * unusedIndices.length)];

      const targetSlot = slotToUpdate === 0 ? slot0 : slot1;

      targetSlot.classList.add('opacity-0', 'scale-95');

      setTimeout(() => {
        if (slotToUpdate === 0) {
          activeIndexSlot0 = newIndex;
        } else {
          activeIndexSlot1 = newIndex;
        }
        renderCardInSlot(slotToUpdate, newIndex);
        updateDots();
        targetSlot.classList.remove('opacity-0', 'scale-95');
      }, 300);
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(shuffleNext, 4500);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = parseInt(dot.getAttribute('data-index') || '0', 10);
        if (targetIdx === activeIndexSlot0 || targetIdx === activeIndexSlot1) return;

        const slotToUpdate = turn % 2;
        turn++;
        const targetSlot = slotToUpdate === 0 ? slot0 : slot1;

        targetSlot.classList.add('opacity-0', 'scale-95');
        setTimeout(() => {
          if (slotToUpdate === 0) {
            activeIndexSlot0 = targetIdx;
          } else {
            activeIndexSlot1 = targetIdx;
          }
          renderCardInSlot(slotToUpdate, targetIdx);
          updateDots();
          targetSlot.classList.remove('opacity-0', 'scale-95');
          startTimer();
        }, 300);
      });
    });

    container.addEventListener('mouseenter', stopTimer);
    container.addEventListener('mouseleave', startTimer);
    container.addEventListener('touchstart', stopTimer, { passive: true });
    container.addEventListener('touchend', startTimer, { passive: true });

    startTimer();
    document.addEventListener('astro:before-preparation', stopTimer, { once: true });
  }

  initSidecarShuffle();
  document.addEventListener('astro:page-load', initSidecarShuffle);
</script>
