---
import { SEO } from "astro-seo";
import { siteConfig } from "site-config";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string;
  type?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image,
  canonical,
  keywords = siteConfig.keywords,
  type = "website",
} = Astro.props;

const siteBase = Astro.site ?? siteConfig.site ?? "https://www.integrationrequired.com";
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteBase).toString();

// Resolve image URL to absolute URL
let resolvedImage = new URL("/opengraph.jpg", siteBase).toString();
if (image) {
  try {
    resolvedImage = image.startsWith("http") ? image : new URL(image, siteBase).toString();
  } catch {
    resolvedImage = image;
  }
}
---

<SEO
  title={title}
  description={description}
  canonical={canonicalURL}
  twitter={{
    creator: siteConfig.seo.twitterHandle,
    site: siteConfig.seo.twitterSite,
    card: "summary_large_image",
  }}
  openGraph={{
    basic: {
      url: canonicalURL,
      type: type,
      title: title,
      image: resolvedImage,
    },
    optional: {
      siteName: "Integration Required",
      locale: "en_US",
      description: description,
    },
    image: {
      alt: title,
    },
  }}
  extend={{
    meta: [
      { name: "keywords", content: keywords },
      { name: "author", content: siteConfig.author },
      { name: "robots", content: "index, follow" },
      { name: "theme-color", content: "#0089e9" },
    ],
  }}
/>

