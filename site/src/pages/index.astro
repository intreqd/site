---
import Container from "@components/elements/Container.astro";
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "site-config";
import LogoWall from "@components/logoWall.astro";
import BlogTicker from "@components/BlogTicker.astro";
import InteropScroller from "@components/InteropScroller.astro";
import SidecarScroller from "@components/SidecarScroller.astro";
import Lanyard from "@components/Lanyard.astro";

// Keep page content data-driven so the homepage stays easy to scan and edit.
const featureCards = [
  {
    title: "DIMSE Cloud",
    description: "Multi Regional DICOM Service Class Provider, and Routing at Scale",
    items: ["IKO Powered Topology", "Google Cloud Healthcare API/DICOM Studio", "Cilium Powered CNI","InterSystems IRIS Data Operations"],
    badges: ["Google Cloud","InterSystems IKO"],
    buttons: [
      { text: "View Stack", url: "https://www.dimsecloud.com", primary: true },
      { text: "Whitepaper", url: "https://docs.astro.build", primary: false }
    ],
    image: "dimse-white.png"
  },
  {
    title: "lifestage.health",
    description: "Transforming high-frequency data from devices like WHOOP into clinical-grade evidence.",
    items: ["WHOOP Data Ingestion", "Multiple CDM Setup - Big Query/IRIS","OHDSI Ecosystem Implementation","Deployed for Global Collaboration"],
    badges: ["OHDSI", "InterSystems OMOP"],
    buttons: [
      { text: "Join the Journey", url: "https://lifestage.health", primary: true },
      { text: "Whitepaper", url: "/trustcenter", primary: false }
    ],
    image: "lsh-white.png"
  },
  {
    title: "PID^TOO||",
    description: "FHIR® has an identify problem, this a battle tested solution.",
    items: ["Machine Learning Powered Detection", "Simplistic Matching & Scoring", "FHIR® Resource Driven Remediation", "Merge Strategies"],
    badges: ["FHIR®", "Google Cloud", "Zingg"],
    buttons: [
      { text: "Resolve Identities", url: "https://www.pidtoo.com", primary: true },
      { text: "Whitepaper", url: "#", primary: false }
    ],
    image: "pidtoowhite.png"
  }
];


const featuredUtilities = [
  {
    title: "iris2bq",
    subtitle: "InterSystems IRIS to BigQuery Sync",
    description: "High-performance Go application to stream InterSystems IRIS tables directly to Google Cloud BigQuery via GCS staging.",
    badges: ["Go", "IRIS", "BigQuery", "GCS"],
    url: "https://iris2bq.integrationrequired.com/",
    logoLeft: "/svg/iris.svg",
    logoRight: "/svg/googleCloud.svg"
  },
  {
    title: "git2iris",
    subtitle: "GitLab & Local Sync to IRIS",
    description: "High-performance Go application to read ObjectScript files from GitLab API v4 or local directories and compile in IRIS.",
    badges: ["Go", "GitLab", "IRIS", "ObjectScript"],
    url: "https://git2iris.integrationrequired.com/",
    logoLeft: "/svg/git.svg",
    logoRight: "/svg/iris.svg"
  },
  {
    title: "iris-sscp",
    subtitle: "IRIS to IRIS File Transfer",
    description: "InterSystems IRIS file transfers over the SuperServer",
    badges: ["Go", "IRIS", "ObjectScript"],
    url: "https://iris-sscp.integrationrequired.com/",
    logoLeft: "/svg/iris.svg",
    logoRight: "/svg/iris.svg"
  }
];


const operationsPillars = [
  {
    title: "InterSystems Kubernetes Operator (IKO)",
    badge: "Cloud-Native & IKO",
    badgeClass: "badge-primary",
    description: "Automated topology deployment, rolling upgrades, and cluster lifecycle management using custom IrisCluster resources.",
    points: [
      "Declarative multi-node cluster topologies: mirrored data nodes, distributed caching via Enterprise Cache Protocol (ECP), and sharded analytics engines.",
      "GitOps continuous delivery with zero-downtime rolling upgrades and containerized maintenance workflows across any Kubernetes platform.",
      "Dynamic persistent volume management, CSI multi-volume storage layouts, and non-disruptive volume resizing.",
      "Enterprise Kubernetes orchestration on Google Cloud (GKE), AWS (EKS), Azure (AKS), and on-premise OpenShift/Kubernetes."
    ],
    tags: ["IKO", "IrisCluster", "ECP", "Sharding", "Kubernetes"]
  },
  {
    title: "High Availability & Data Protection",
    badge: "HA & Mirroring",
    badgeClass: "badge-primary",
    description: "Architected for continuous 24/7 database availability, split-brain protection, and zero data loss recovery.",
    points: [
      "Synchronous failover mirroring paired with ISCAgent Arbiter for instant, automated failover without split-brain risk.",
      "Disaster recovery (DR) async nodes and reporting async members to offload heavy analytical queries from OLTP primary.",
      "Storage-grade zero-impact backups utilizing external Freeze/Thaw APIs (SYS.Database.Freeze/Thaw) for storage snapshot integration.",
      "Write Image Journal (WIJ) health monitoring, primary/alternate journal directory failover, and crash recovery safety."
    ],
    tags: ["Mirroring", "Arbiter", "Freeze/Thaw", "WIJ & Journals"]
  },
  {
    title: "Performance Tuning & Diagnostics",
    badge: "System Administration",
    badgeClass: "badge-primary",
    description: "Deep-dive diagnostic analysis and configuration tuning to maximize throughput and resolve resource contention.",
    points: [
      "Diagnostic profiling and bottleneck isolation using ^SystemPerformance (pButtons), ^PERFMON, and messages.log telemetry.",
      "Configuration Parameter File (iris.cpf) optimization: tuning global buffers (globals), routine buffers, locks, and shared memory (gmheap).",
      "Process contention and concurrency management: lock table deadlock resolution (^LOCKTAB) and semaphore optimization.",
      "Scheduled database integrity audits (^Integrity), block allocation checks, and enterprise security hardening (RBAC & TLS)."
    ],
    tags: ["^SystemPerformance", "iris.cpf", "Buffer Tuning", "^Integrity"]
  },
  {
    title: "Legacy Modernization & Support",
    badge: "Staff Augmentation",
    badgeClass: "badge-primary",
    description: "Bridging technical talent gaps with senior operational leadership for mission-critical healthcare and enterprise IT.",
    points: [
      "Low-risk migrations from legacy Caché, Ensemble, and MUMPS to modern InterSystems IRIS Data Platform & IRIS for Health.",
      "Production cutover planning, data reconciliation, interface verification (HealthShare & Health Connect), and go-live leadership.",
      "Fractional systems leadership: augmenting internal teams during high-stakes implementations, upgrades, and platform scaling.",
      "Rapid incident triage, 24/7 on-call escalation support, and root-cause remediation for production outages."
    ],
    tags: ["Caché Migration", "HealthShare", "Fractional DBA", "24/7 Reliability"]
  }
];

const supportCapabilities = [
  {
    role: "Fractional / Contract Systems Operator",
    detail: "Dedicated senior operational lead embedded with your engineering team to manage, monitor, and maintain enterprise IRIS clusters."
  },
  {
    role: "IKO & Cloud Migration Architect",
    detail: "Modernizing legacy on-premises workloads into automated, scalable Kubernetes topologies with GitOps CI/CD."
  },
  {
    role: "Emergency Performance & Diagnostic Triage",
    detail: "Deep-dive pButtons health audits to resolve locking deadlocks, buffer thrashing, and high-concurrency database stalls."
  },
  {
    role: "Zero-Downtime Migration & Cutover Lead",
    detail: "End-to-end execution of platform upgrades from Caché/Ensemble to IRIS for Health with zero data loss."
  }
];
---

<Layout
  title="Integration Required | Named Technical Interoperability Engineer & InterSystems IRIS Specialist"
  description="Ron Sweeney — Contract healthcare interoperability engineer and InterSystems Implementation Partner specializing in InterSystems Kubernetes Operator (IKO), HA mirroring, performance tuning, and cloud-native healthcare data platforms."
  image="/opengraph.jpg"
>
  <Container class="pt-6 sm:pt-8 lg:pt-12 pb-3 sm:pb-4 lg:pb-6">
    <!--
      Mobile-first structure:
      1. Start with a single-column stack that reads well on narrow screens.
      2. Introduce multi-column layouts only from `lg:` upward.
    -->
    <section class="space-y-8 lg:grid lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,24rem)] lg:gap-10 lg:space-y-0">
      <div class="flex flex-col gap-6">
        <div class="badge badge-outline h-auto py-1.5 px-3 text-xs sm:text-sm font-medium max-w-fit leading-relaxed">
          Short/Long Term Contracts, Remote or On-Site Projects, Worldwide
        </div>

        <div class="space-y-4">
          <h1 class="max-w-3xl text-2xl font-bold tracking-tight sm:text-3xl">
            Named Technical Interoperability Engineer
          </h1>
          <p class="max-w-2xl text-base text-base-content/70 sm:text-lg">
Accelerate your workload, develop your Managed Service or strategic initiative with a short or long-term contract. Build secure, reliable, and performant workloads, healthcare interoperability, and advanced analytics at impossible deployment speeds.
          </p>

        </div>

        <BlogTicker />

        <SidecarScroller items={featuredUtilities} />
      </div>

      <aside class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div class="mt-2 space-y-3">
            <div class="w-full h-[400px] sm:h-[440px] overflow-hidden rounded-box">
              <Lanyard
                frontImage="/badge2.png"
                backImage="/isc.png"
                strapColor="#0089e9"
                strapLength={0.18}
                size={0.65}
              />
            </div>
          </div>
          <InteropScroller />
        </div>
      </aside>
    </section>

    <LogoWall />

    <div class="card mb-6 border border-transparent dark:border-white/10 shadow-sm transition-all duration-300 hover:shadow-md bg-gradient-to-r from-[#FFE5E5] via-[#FFF0E5] to-[#FFF9E5] dark:from-[#2d1215] dark:via-[#1e1319] dark:to-[#171522]">
      <div class="card-body flex-col sm:flex-row items-center justify-between gap-4 p-5">
        <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left w-full sm:w-auto">
          <h2 class="card-title text-base font-bold m-0 text-black dark:text-white">Analytics on FHIR&reg; with BigQuery</h2>
          <div class="flex flex-wrap justify-center sm:justify-start gap-1.5">
            <span class="badge badge-sm font-medium bg-white/60 dark:bg-white/10 px-2.5 py-3 whitespace-nowrap border-black/10 dark:border-white/20 text-black/80 dark:text-white/90">Google Cloud</span>
            <span class="badge badge-sm font-medium bg-white/60 dark:bg-white/10 px-2.5 py-3 whitespace-nowrap border-black/10 dark:border-white/20 text-black/80 dark:text-white/90">BigQuery</span>
            <span class="badge badge-sm font-medium bg-white/60 dark:bg-white/10 px-2.5 py-3 whitespace-nowrap border-black/10 dark:border-white/20 text-black/80 dark:text-white/90">Schema Evolution</span>
            <span class="badge badge-sm font-medium bg-white/60 dark:bg-white/10 px-2.5 py-3 whitespace-nowrap border-black/10 dark:border-white/20 text-black/80 dark:text-white/90">Flattening</span>
          </div>
        </div>
        <a href="#" data-ga-event="whitepaper_download" class="btn btn-sm shrink-0 bg-[#e11f26] hover:bg-[#b91a1f] text-white border-0">Download</a>
      </div>
    </div>

    <!-- Secondary information becomes a grid of 3 cards styled like the checklist. -->
    <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featureCards.map((card) => (
        <div 
          class:list={[
            "card card-compact relative overflow-hidden border border-base-300 shadow-sm transition-all duration-300 hover:shadow-md",
            card.title === "DIMSE Cloud" ? "bg-black text-white" : (card.title === "PID^TOO||" ? "text-white" : "bg-base-100")
          ]}
          style={card.title === "PID^TOO||" ? "background-color: #111D30" : (card.title === "lifestage.health" ? "background-color: #C8D5B9" : "")}
        >
          <div class="card-body gap-5 relative z-10">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-3">
                <h2 class:list={["card-title text-base font-bold", card.title === "lifestage.health" && "text-black"]}>{card.title}</h2>
                <div class="flex flex-wrap justify-end gap-1.5">
                  {card.badges.map((badge) => (
                    <span class:list={[
                      "badge badge-sm font-medium bg-transparent px-2.5 py-3 whitespace-nowrap",
                      card.title === "lifestage.health" ? "border-black text-black" : "border-white/50 text-white"
                    ]}>
                      {badge}
                    </span>
                  ))}
                </div>
              </div>
              <p class:list={[
                "text-sm", 
                (card.title === "DIMSE Cloud" || card.title === "PID^TOO||") ? "text-white/70" : (card.title === "lifestage.health" ? "text-black/70" : "text-base-content/70")
              ]}>
                {card.description}
              </p>
            </div>
            
            <ul class:list={[
              "list-disc space-y-2 pl-5 text-sm", 
              (card.title === "DIMSE Cloud" || card.title === "PID^TOO||") ? "text-white/80" : (card.title === "lifestage.health" ? "text-black/80" : "text-base-content/80")
            ]}>
              {card.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <div class="card-actions justify-start mt-auto">
              {card.buttons.map((btn) => (
                <a 
                  href={btn.url} 
                  class:list={[
                    "btn btn-sm",
                    btn.primary ? (
                      card.title === "PID^TOO||" ? "text-white border-0" : 
                      (card.title === "lifestage.health" ? "text-black border-0" : "btn-primary")
                    ) : (
                      (card.title === "DIMSE Cloud" || card.title === "PID^TOO||") ? "btn-outline text-white hover:bg-white hover:text-black" : 
                      (card.title === "lifestage.health" ? "btn-outline border-black text-black hover:bg-black hover:text-white" : "btn-ghost")
                    )
                  ]}
                  style={
                    btn.primary ? (
                      card.title === "PID^TOO||" ? "background-color: #08AA6E" : 
                      (card.title === "lifestage.health" ? "background-color: #8fc0a9" : "")
                    ) : ""
                  }
                >
                  {btn.text}
                </a>
              ))}
            </div>
          </div>
          <img src={card.image || "https://placehold.co/100x300"} alt="" class:list={["absolute bottom-0.5 right-0.5 w-auto pointer-events-none", card.image ? "opacity-100" : "opacity-10", card.title === "PID^TOO||" ? "h-40" : "h-32"]} />
        </div>
      ))}
    </section>

    <!-- Dedicated Section: Operating and Supporting Large-Scale InterSystems IRIS -->
    <section class="mt-14 sm:mt-20 space-y-8" id="operations">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-base-300 pb-5">
        <div class="space-y-2 max-w-3xl flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-primary badge-outline text-xs font-semibold tracking-wider uppercase">
              Operations &amp; Systems Support
            </span>
            <span class="badge badge-neutral text-xs font-medium">Large-Scale Deployments</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-base-content">
            Supporting &amp; Operating Large-Scale InterSystems IRIS
          </h2>
          <p class="text-sm sm:text-base text-base-content/70">
            Specialized contract engineering and operational leadership for mission-critical InterSystems IRIS, HealthShare, and cloud-native Kubernetes workloads. Delivering high-availability mirroring, deep-dive performance diagnostics, and zero-downtime legacy modernizations.
          </p>
        </div>
        <a 
          href="mailto:hi@integrationrequired.com?subject=InterSystems%20IRIS%20Operations%20%26%20Support"
          class="shrink-0 self-start md:self-center flex justify-end transition-transform duration-300 hover:scale-105"
          aria-label="Inquire for Support - InterSystems Kubernetes Operator"
          title="Inquire for InterSystems IRIS Operations Support"
        >
          <img 
            src="/iko_plus_black.png" 
            alt="InterSystems Kubernetes Operator" 
            class="h-20 sm:h-24 md:h-28 w-auto object-contain iko-logo-light block dark:hidden" 
          />
          <img 
            src="/iko_plus_white.png" 
            alt="InterSystems Kubernetes Operator" 
            class="h-20 sm:h-24 md:h-28 w-auto object-contain iko-logo-dark hidden dark:block" 
          />
        </a>
      </div>

      <!-- 4 Operational Pillars Grid -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {operationsPillars.map((pillar) => (
          <div class="card border border-base-300 bg-base-100 shadow-sm transition-all duration-300 hover:shadow-md hover:border-primary/40 flex flex-col justify-between">
            <div class="card-body p-5 gap-0">
              <div class="space-y-1.5">
                <span class:list={["badge badge-sm font-semibold uppercase tracking-wider text-[10px]", pillar.badgeClass]}>
                  {pillar.badge}
                </span>
                <h3 class="card-title text-base font-bold leading-snug text-base-content">
                  {pillar.title}
                </h3>
                <p class="text-xs text-base-content/70 leading-relaxed">
                  {pillar.description}
                </p>
              </div>

              <div class="border-t border-base-300 my-2.5"></div>

              <ul class="space-y-1.5 text-xs text-base-content/80">
                {pillar.points.map((pt) => (
                  <li class="flex items-start gap-2">
                    <span class="text-primary font-bold shrink-0 mt-0.5">&bull;</span>
                    <span class="leading-relaxed">{pt}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="px-5 pb-5 pt-0 mt-auto">
              <div class="flex flex-wrap gap-1">
                {pillar.tags.map((tag) => (
                  <span class="badge badge-xs badge-ghost text-[10px] text-base-content/70">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Engagement Models Strip (Henry Elliott inspired opportunities & staffing) -->
      <div class="rounded-box border border-base-300 bg-base-100 p-6 sm:p-8 shadow-sm">
        <div class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div class="max-w-2xl lg:max-w-3xl space-y-2">
              <h3 class="text-lg sm:text-xl font-bold tracking-tight text-base-content">
                Flexible Operational Engagement Models
              </h3>
              <p class="text-xs sm:text-sm text-base-content/70">
                Whether augmenting an internal engineering team during a high-stakes cutover, migrating legacy environments, or providing ongoing fractional platform operations, engagements are structured for maximum technical impact and zero business disruption.
              </p>
            </div>

            <div class="shrink-0 self-start sm:self-center flex items-center justify-end">
              <img 
                src="/makesvg/combined.svg" 
                alt="Operational Engagement Models Capabilities" 
                class="h-16 sm:h-20 md:h-24 lg:h-28 w-auto object-contain transition-transform duration-300 hover:scale-105"
              />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {supportCapabilities.map((cap) => (
              <div class="rounded-lg border border-base-300/80 bg-base-200/40 p-4 space-y-1.5 transition-all duration-300 hover:border-primary/30">
                <h4 class="text-xs sm:text-sm font-bold text-base-content">
                  {cap.role}
                </h4>
                <p class="text-xs text-base-content/70 leading-relaxed">
                  {cap.detail}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </Container>
</Layout>

<style>
  .iko-logo-dark {
    display: none;
  }
  :global([data-theme="dark"]) .iko-logo-light {
    display: none !important;
  }
  :global([data-theme="dark"]) .iko-logo-dark {
    display: block !important;
  }
</style>


