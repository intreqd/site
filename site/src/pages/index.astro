---
import Container from "@components/elements/Container.astro";
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "site-config";
import LogoWall from "@components/logoWall.astro";
import BlogTicker from "@components/BlogTicker.astro";
import InteropScroller from "@components/InteropScroller.astro";

// Keep page content data-driven so the homepage stays easy to scan and edit.
const featureCards = [
  {
    title: "DIMSE Cloud",
    description: "Multi Regional DICOM Service Class Provider, and Routing at Scale",
    items: ["IKO Powered Topology", "Google Cloud Healthcare API/DICOM Studio", "Cilium Powered CNI","InterSystems IRIS Data Operations"],
    badges: ["Google Cloud","InterSystems IKO"],
    buttons: [
      { text: "View Stack", url: "https://www.dimsecloud.com", primary: true },
      { text: "Whitepaper", url: "https://docs.astro.build", primary: false }
    ],
    image: "dimse-white.png"
  },
  {
    title: "lifestage.health",
    description: "Transforming high-frequency data from devices like WHOOP into clinical-grade evidence.",
    items: ["WHOOP Data Ingestion", "Multiple CDM Setup - Big Query/IRIS","OHDSI Ecosystem Implementation","Deployed for Global Collaboration"],
    badges: ["OHDSI", "InterSystems OMOP"],
    buttons: [
      { text: "Join the Journey", url: "https://lifestage.health", primary: true },
      { text: "Whitepaper", url: "/imprint", primary: false }
    ],
    image: "lsh-white.png"
  },
  {
    title: "PID^TOO||",
    description: "FHIR® has an identify problem, this a battle tested solution.",
    items: ["Machine Learning Powered Detection", "Simplistic Matching & Scoring", "FHIR® Resource Driven Remediation", "Merge Strategies"],
    badges: ["FHIR®", "Google Cloud", "Zingg"],
    buttons: [
      { text: "Resolve Identities", url: "https://www.pidtoo.com", primary: true },
      { text: "Whitepaper", url: "#", primary: false }
    ],
    image: "pidtoowhite.png"
  }
];


const featuredUtilities = [
  {
    title: "iris2bq",
    subtitle: "InterSystems IRIS to BigQuery Sync",
    description: "High-performance Go application to stream InterSystems IRIS tables directly to Google Cloud BigQuery via GCS staging.",
    badges: ["Go", "IRIS", "BigQuery", "GCS"],
    url: "https://iris2bq.integrationrequired.com/",
    logoLeft: "/svg/iris.svg",
    logoRight: "/svg/googleCloud.svg"
  },
  {
    title: "git2iris",
    subtitle: "GitLab & Local Sync to IRIS",
    description: "High-performance Go application to read ObjectScript files from GitLab API v4 or local directories and compile in IRIS.",
    badges: ["Go", "GitLab", "IRIS", "ObjectScript"],
    url: "https://git2iris.integrationrequired.com/",
    logoLeft: "/svg/git.svg",
    logoRight: "/svg/iris.svg"
  }
];

const starterTraits = [
  {
    logo: "/isc.png",
    logoPos: "left",
    textAlign: "right",
    text: '<a href="https://www.credly.com/users/sween" target="_blank" rel="noopener noreferrer" class="hover:underline text-primary transition-colors">Certified</a> and battle tested on InterSystems technologies, preferred weapon of mass solution and <a href="https://community.intersystems.com/user/sween" target="_blank" rel="noopener noreferrer" class="hover:underline text-primary transition-colors">developer community expert</a>.'
  },
  {
    logo: "https://raw.githubusercontent.com/cncf/artwork/main/projects/kubernetes/icon/color/kubernetes-icon-color.svg",
    logoPos: "left",
    textAlign: "left",
    text: 'CNCF <a href="https://www.credly.com/users/sween" target="_blank" rel="noopener noreferrer" class="hover:underline text-primary transition-colors">Certified</a> with deep cloud-native architecture expertise, I deploy here first and maintain a <a href="https://openprofile.dev/profile/ronsween" target="_blank" rel="noopener noreferrer" class="hover:underline text-primary transition-colors">Linux Foundation Profile</a>.'
  },
  {
    logo: "/svg/googleCloud.svg",
    logoPos: "right",
    textAlign: "left",
    text: '<a href="https://www.credly.com/users/sween" target="_blank" rel="noopener noreferrer" class="hover:underline text-primary transition-colors">Certified</a> and steward of production workloads and public Cloud of choice.  <a href="https://developers.google.com/program/gear/" target="_blank" rel="noopener noreferrer" class="hover:underline text-primary transition-colors">GEAR</a> and <a href="https://me.developers.google.com/u/ronsweeney" target="_blank" rel="noopener noreferrer" class="hover:underline text-primary transition-colors">g.developer</a> decorated.'
  }
];
---

<Layout
  title="Integration Required | Healthcare Interoperability Engineer"
  description="Ron Sweeney — Contract healthcare interoperability engineer specializing in FHIR®, DICOM, OHDSI/OMOP, InterSystems IRIS, and Google Cloud. Available for short and long-term contracts."
>
  <Container class="pt-6 sm:pt-8 lg:pt-12 pb-3 sm:pb-4 lg:pb-6">
    <!--
      Mobile-first structure:
      1. Start with a single-column stack that reads well on narrow screens.
      2. Introduce multi-column layouts only from `lg:` upward.
    -->
    <section class="space-y-8 lg:grid lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,24rem)] lg:gap-10 lg:space-y-0">
      <div class="flex flex-col gap-6">
        <p class="badge badge-outline">Independent Contractor</p>

        <div class="space-y-4">
          <h1 class="max-w-3xl text-2xl font-bold tracking-tight sm:text-3xl">
            Named Technical Interoperability Engineer
          </h1>
          <p class="max-w-2xl text-base text-base-content/70 sm:text-lg">
Accelerate your workload, develop your Managed Service or strategic initiative with a short or long-term contract. Build secure, reliable, and performant workloads, healthcare interoperability, and advanced analytics at impossible deployment speeds.
          </p>

        </div>

        <div class="mt-auto space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            {featuredUtilities.map((util) => (
              <div class="flex flex-col justify-between gap-3 rounded-box border border-base-300 bg-base-100 p-5 shadow-sm transition-all duration-300 hover:shadow-md hover:border-primary/40 group">
                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                      <img src={util.logoLeft} alt="" class="h-6 w-6 object-contain dark:invert" />
                      <span class="text-xs text-base-content/40 font-mono">&rarr;</span>
                      <img src={util.logoRight} alt="" class="h-6 w-6 object-contain dark:invert" />
                      <h3 class="font-bold text-base text-base-content group-hover:text-primary transition-colors">
                        {util.title}
                      </h3>
                    </div>
                    <span class="badge badge-xs font-mono uppercase tracking-wider bg-base-200 border-base-300 text-base-content/70 px-2 py-1.5">
                      Sidecar
                    </span>
                  </div>
                  <p class="text-xs font-semibold text-primary">{util.subtitle}</p>
                  <p class="text-xs text-base-content/70 leading-relaxed">
                    {util.description}
                  </p>
                </div>

                <div class="flex items-center justify-between gap-2 pt-2 border-t border-base-200 mt-1">
                  <div class="flex flex-wrap gap-1">
                    {util.badges.map((badge) => (
                      <span class="badge badge-xs font-medium bg-base-200 text-base-content/80 border-0 px-2 py-1">
                        {badge}
                      </span>
                    ))}
                  </div>
                  <a
                    href={util.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-xs btn-primary gap-1 font-mono text-[10px]"
                  >
                    Download &rarr;
                  </a>
                </div>
              </div>
            ))}
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            {starterTraits.map((item) => (
              <div class="flex items-center gap-4 rounded-box border border-base-300 bg-base-100 px-5 py-4 shadow-sm">
                {item.logoPos === "left" && (
                  <img src={item.logo} alt="" class="h-10 w-10 shrink-0 object-contain dark:invert" />
                )}
                <p 
                  class:list={[
                    "flex-1 text-sm font-medium text-base-content/80 leading-relaxed",
                    item.textAlign === "right" && "text-right",
                    item.textAlign === "left" && "text-left"
                  ]}
                  set:html={item.text}
                />
                {item.logoPos === "right" && (
                  <img src={item.logo} alt="" class="h-10 w-10 shrink-0 object-contain dark:invert" />
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      <aside class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div class="mt-2 space-y-3">
            <div class="hover-gallery rounded-box w-full aspect-4/3 overflow-hidden [--items:4]">
              <img src="ron.png" alt="Abstract 1" />
              <img src="ron2.png" alt="Abstract 2" />
              <img src="ron3.png" alt="Abstract 3" />
            </div>
          </div>
          <InteropScroller />
          <BlogTicker />
        </div>
      </aside>
    </section>

    <LogoWall />

    <div class="card mb-6 border-0 shadow-sm transition-all duration-300 hover:shadow-md bg-gradient-to-r from-[#FFE5E5] via-[#FFF0E5] to-[#FFF9E5]">
      <div class="card-body flex-col sm:flex-row items-center justify-between gap-4 p-5">
        <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left w-full sm:w-auto">
          <h2 class="card-title text-base font-bold m-0 text-base-content">Analytics on FHIR&reg; with BigQuery</h2>
          <div class="flex flex-wrap justify-center sm:justify-start gap-1.5">
            <span class="badge badge-sm font-medium bg-white/60 px-2.5 py-3 whitespace-nowrap border-base-content/10 text-base-content/80">Google Cloud</span>
            <span class="badge badge-sm font-medium bg-white/60 px-2.5 py-3 whitespace-nowrap border-base-content/10 text-base-content/80">BigQuery</span>
            <span class="badge badge-sm font-medium bg-white/60 px-2.5 py-3 whitespace-nowrap border-base-content/10 text-base-content/80">Schema Evolution</span>
            <span class="badge badge-sm font-medium bg-white/60 px-2.5 py-3 whitespace-nowrap border-base-content/10 text-base-content/80">Flattening</span>
          </div>
        </div>
        <a href="#" class="btn btn-sm shrink-0 bg-[#e11f26] hover:bg-[#b91a1f] text-white border-0">Download</a>
      </div>
    </div>

    <!-- Secondary information becomes a grid of 3 cards styled like the checklist. -->
    <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featureCards.map((card) => (
        <div 
          class:list={[
            "card card-compact relative overflow-hidden border border-base-300 shadow-sm transition-all duration-300 hover:shadow-md",
            card.title === "DIMSE Cloud" ? "bg-black text-white" : (card.title === "PID^TOO||" ? "text-white" : "bg-base-100")
          ]}
          style={card.title === "PID^TOO||" ? "background-color: #111D30" : (card.title === "lifestage.health" ? "background-color: #C8D5B9" : "")}
        >
          <div class="card-body gap-5 relative z-10">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-3">
                <h2 class:list={["card-title text-base font-bold", card.title === "lifestage.health" && "text-black"]}>{card.title}</h2>
                <div class="flex flex-wrap justify-end gap-1.5">
                  {card.badges.map((badge) => (
                    <span class:list={[
                      "badge badge-sm font-medium bg-transparent px-2.5 py-3 whitespace-nowrap",
                      card.title === "lifestage.health" ? "border-black text-black" : "border-white/50 text-white"
                    ]}>
                      {badge}
                    </span>
                  ))}
                </div>
              </div>
              <p class:list={[
                "text-sm", 
                (card.title === "DIMSE Cloud" || card.title === "PID^TOO||") ? "text-white/70" : (card.title === "lifestage.health" ? "text-black/70" : "text-base-content/70")
              ]}>
                {card.description}
              </p>
            </div>
            
            <ul class:list={[
              "list-disc space-y-2 pl-5 text-sm", 
              (card.title === "DIMSE Cloud" || card.title === "PID^TOO||") ? "text-white/80" : (card.title === "lifestage.health" ? "text-black/80" : "text-base-content/80")
            ]}>
              {card.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <div class="card-actions justify-start mt-auto">
              {card.buttons.map((btn) => (
                <a 
                  href={btn.url} 
                  class:list={[
                    "btn btn-sm",
                    btn.primary ? (
                      card.title === "PID^TOO||" ? "text-white border-0" : 
                      (card.title === "lifestage.health" ? "text-black border-0" : "btn-primary")
                    ) : (
                      (card.title === "DIMSE Cloud" || card.title === "PID^TOO||") ? "btn-outline text-white hover:bg-white hover:text-black" : 
                      (card.title === "lifestage.health" ? "btn-outline border-black text-black hover:bg-black hover:text-white" : "btn-ghost")
                    )
                  ]}
                  style={
                    btn.primary ? (
                      card.title === "PID^TOO||" ? "background-color: #08AA6E" : 
                      (card.title === "lifestage.health" ? "background-color: #8fc0a9" : "")
                    ) : ""
                  }
                >
                  {btn.text}
                </a>
              ))}
            </div>
          </div>
          <img src={card.image || "https://placehold.co/100x300"} alt="" class:list={["absolute bottom-0.5 right-0.5 w-auto pointer-events-none", card.image ? "opacity-100" : "opacity-10", card.title === "PID^TOO||" ? "h-40" : "h-32"]} />
        </div>
      ))}
    </section>
  </Container>
</Layout>


